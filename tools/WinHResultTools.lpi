<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="WinHResultTools"/>
      <UseAppBundle Value="False"/>
    </General>
    <RequiredPackages><Item><PackageName Value="LCL"/></Item></RequiredPackages>
    <BuildModes><Item Name="Default" Default="True"/></BuildModes>
    <Units>
      <Unit><Filename Value="WinHResultTools.lpr"/><IsPartOfProject Value="True"/></Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target><Filename Value="../build/debug-tools/WinHResultTools.exe"/></Target>
    <SearchPaths>
      <IncludeFiles Value="../src"/>
      <OtherUnitFiles Value=".;../src;../src/debug"/>
      <UnitOutputDirectory Value="../build/debug-tools/units"/>
    </SearchPaths>
    <Parsing><SyntaxOptions><SyntaxMode Value="DelphiUnicode"/></SyntaxOptions></Parsing>
    <CodeGeneration><TargetCPU Value="x86_64"/><TargetOS Value="win64"/></CodeGeneration>
    <Linking><Debugging><GenerateDebugInfo Value="True"/><DebugInfoType Value="dsDwarf3"/></Debugging></Linking>
    <Other><CustomOptions Value="-dDEBUG -Sa"/></Other>
  </CompilerOptions>
</CONFIG>